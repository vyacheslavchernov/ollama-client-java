<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %highlight(%-5level) %logger{36}:%L - %msg%n</pattern>
        </encoder>
    </appender>


    <!-- Корневой логгер -->
    <root level="debug">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
